LISTEN_ADDR=127.0.0.1:8787
PUBLIC_URL=http://localhost:8787
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_URL=postgres://fixed_egress_app:CHANGE_ME@127.0.0.1:5432/fixed_egress_workspace?sslmode=disable
# DATA_DIR stores the encryption key; account records are in PostgreSQL.
DATA_DIR=data
# Optional base64-encoded 32-byte AES key; otherwise data/encryption.key is generated.
DATA_ENCRYPTION_KEY=
# Only trusted reverse proxies may supply X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
